{
  "name": "ivendor-superapps-api",
  "version": "1.0.0",
  "description": "starter backend node js",
  "main": "app.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma": "ts-node scripts/prisma-action.ts",
    "dev": "nodemon --exec ts-node src/app.ts",
    "db:generate": "npx prisma generate --schema=prisma/schema.ivendor_reborn.prisma",
    "db:push": "npx prisma db push --schema=prisma/schema.ivendor_reborn.prisma",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=prisma/schema.ivendor_reborn.prisma"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/28mreza/starter-backend.git"
  },
  "author": "Muhamad Reza",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/28mreza/starter-backend/issues"
  },
  "homepage": "https://github.com/28mreza/starter-backend#readme",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcrypt": "^6.0.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-file-routing": "^3.0.3",
    "express-fileupload": "^1.5.1",
    "figlet": "^1.10.0",
    "g": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.9"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.13",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "_moduleAliases": {
    "@": "./src"
  }
